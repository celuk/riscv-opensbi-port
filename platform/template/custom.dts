/dts-v1/;

/ {
    #address-cells = <1>;
    #size-cells = <1>;
    compatible = "custom-platform", "simple-bus";
    model = "CVA6-SoC";

    chosen {
        bootargs = "console=hvc0 earlycon=sbi";
    };

    cpus {
        #address-cells = <1>;
        #size-cells = <0>;
        timebase-frequency = <1000000>;

        cpu@0 {
            device_type = "cpu";
            reg = <0>;
            status = "okay";
            compatible = "riscv";
            riscv,isa = "rv32imac";
            mmu-type = "riscv,sv32";
            clock-frequency = <50000000>;

            intc: interrupt-controller {
                #interrupt-cells = <1>;
                #address-cells = <0>;
                #size-cells = <0>;
                compatible = "riscv,cpu-intc";
                interrupt-controller;
            };
        };
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x10000000>;
    };

    soc {
        #address-cells = <1>;
        #size-cells = <1>;
        compatible = "simple-bus";
        ranges;

        clint: clint@ff080000 {
            compatible = "riscv,clint0";
            reg = <0xff080000 0x10000>;
            interrupts-extended = <&intc 3 &intc 7>;
        };

        // Use kernel's SBI HVC driver
        // It does not need reg, clock, or speed properties as it is a virtual device
        sbi_hvc: sbi-hvc {
            compatible = "riscv,sbi-hvc";
        };
    };
};
